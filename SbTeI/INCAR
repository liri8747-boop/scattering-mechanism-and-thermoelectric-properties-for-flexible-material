SYSTEM=Si               # 系统名称，仅用于标识，不影响计算
ENCUT=520              # 截断能（单位 eV），决定平面波基组大小,经验一般为POTCAR中ENMAX的1.3-1.5倍，最好是测试
ISTART=0                # 从头开始计算（不读取 WAVECAR）
ICHARG=2                # 从原子电子密度开始（不读取 CHGCAR）
ISMEAR=0                # 使用 Gaussian 展宽，适合半导体/绝缘体
SIGMA=0.01              # 展宽宽度（eV），值越小越精细
NCORE=16                 # 设置每组使用 8 核心
#LNONCOLLINEAR=TRUE      # 非共线自旋设置（用于 SOC，当前注释）
#LSORBIT=TRUE            # 开启自旋轨道耦合（SOC）
#SAXIS=0 0 1             # SOC 的量子轴方向（通常设为 z 轴）
ISIF=3                  # 3结构优化时优化原子位置 + 晶格参数 + 体积
ISPIN=2                 # 是否开启自旋极化（磁性系统必须）
LWAVE=F             # F不写出 WAVECAR（节省空间）
LCHARG=F            # F不写出 CHGCAR（节省空间）
PREC=Accurate           # 计算精度（可为 Low / Normal / Accurate）
ALGO=N                  # N使用 Davidson 算法，适合大多数系统
EDIFF=1E-8              # 电子步能量收敛准则（单位 eV）
EDIFFG=-1E-2       # 结构优化力收敛准则（负号代表按力收敛，单位 eV/Å）
IBRION=2                # 使用共轭梯度算法进行离子优化
POTIM=0.1               # 离子移动步长
NELM=300                # 最大电子步迭代次数
NSW=300                 # 最大离子步数（结构优化步数）
IVDW=12
ISYM=0
